# Terraform secrets — environment variable template.
#
# Copy this file to `secrets.env` (gitignored), fill in real values, then load
# them into your shell before running terraform:
#
#   cp secrets.env.example secrets.env
#   $EDITOR secrets.env
#   source secrets.env
#   terraform plan   # or: terraform apply
#
# Terraform automatically reads TF_VAR_<name> for each input variable, so these
# exports populate cloudflare_tunnel_token / datadog_api_key without committing
# real values to any tfvars file.

# Cloudflare Tunnel connector token (Zero Trust > Networks > Tunnels).
# Required: it is the app's only ingress once the public LoadBalancer is removed.
export TF_VAR_cloudflare_tunnel_token=""

# Datadog API key (Organization Settings > API Keys).
# Optional: leave empty to skip Datadog entirely.
export TF_VAR_datadog_api_key=""

# Optional: override the Datadog site (otherwise taken from terraform.tfvars).
# export TF_VAR_datadog_site="datadoghq.com"
